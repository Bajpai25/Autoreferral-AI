    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "./**/*.ts",
    "worker.ts",
    "server.cjs"
  ],
  "exclude": [
    "node_modules"
  ]
}